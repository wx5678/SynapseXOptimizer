{
  "name": "synapsex-optimizer",
  "description": "Chinese local-first Windows game optimizer for JiuYin Online",
  "author": "SynapseX",
  "private": true,
  "version": "0.39.33",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "pnpm run build && electron .",
    "package:win": "pnpm run build && electron-builder --win portable"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.14"
  },
  "build": {
    "appId": "com.synapsex.gameoptimizer",
    "productName": "SynapseX 游戏优化器",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/0.39.33-nvidia-nip"
    },
    "files": [
      "electron/**/*",
      "host/feature-access.json",
      "package.json"
    ],
    "extraResources": [
      { "from": "tools/sensors/lhm-0.9.6", "to": "tools/sensors/lhm-0.9.6", "filter": ["*.dll", "LICENSE", "THIRD-PARTY.md", "THIRD-PARTY-NOTICES.txt"] },
      { "from": "build/icon.png", "to": "build/icon.png" },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "host",
        "to": "host",
        "filter": ["**/*", "!modules/JiuYinKeybindProfiles.psm1"]
      },
      {
        "from": "tools/presentmon",
        "to": "tools/presentmon"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": { "unpackDirName": true },
    "artifactName": "SynapseX-Game-Optimizer-${version}.${ext}"
  }
}
